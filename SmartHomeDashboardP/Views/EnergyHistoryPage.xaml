<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartHomeDashboardP.ViewModels"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="SmartHomeDashboardP.Views.EnergyHistoryPage"
             Title="Energy History">

    <ContentPage.BindingContext>
        <viewmodels:EnergyHistoryViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="📊 Energy Usage Over Time"
                   FontSize="26"
                   TextColor="DodgerBlue"
                   HorizontalOptions="Center" />

            <Frame
                BackgroundColor="Transparent"
                CornerRadius="25"
                Padding="0"
                HeightRequest="300">

                <AbsoluteLayout>

                    <!-- Chart -->
                    <microcharts:ChartView
                        x:Name="HistoryChartView"
                        Chart="{Binding EnergyHistoryChart}"
                        BackgroundColor="Transparent"
                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All" /> 

                    <!-- Cursor dot -->
                    <BoxView
                        x:Name="CursorDot"
                        WidthRequest="8"
                        HeightRequest="8"
                        CornerRadius="4"
                        Color="#1E88E5"
                        IsVisible="False"
                        AbsoluteLayout.LayoutFlags="None" />

                    <!-- Tooltip -->
                    <Frame
                        x:Name="TooltipFrame"
                        Padding="6,4"
                        CornerRadius="6"
                        BackgroundColor="#CC1E88E5"
                        IsVisible="False"
                        HasShadow="False"
                        AbsoluteLayout.LayoutFlags="None">

                        <Label
                            x:Name="TooltipLabel"
                            TextColor="White"
                            FontSize="12"
                            VerticalOptions="Center" />
                    </Frame>

                </AbsoluteLayout>
            </Frame>


            <Button Text="🔙 Back to Dashboard"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="20"
                    HeightRequest="50"
                    Margin="0,20,0,0"
                    HorizontalOptions="Center"
                    WidthRequest="250" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
